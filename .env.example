# ------------------------------------------------------------------
# AIBA Sync — Tracking System (copy this file to .env.local locally)
# NEVER commit .env.local — .gitignore protects it.
# ------------------------------------------------------------------

# Neon PostgreSQL — POOLED connection (app runtime / serverless)
# Neon Console → Project → Connect → "Pooled connection"
DATABASE_URL=

# Neon PostgreSQL — DIRECT connection (only for migrations/psql, NOT used by the app)
# Neon Console → Project → Connect → "Direct connection"
DIRECT_URL=

# Password for your /admin stats dashboard (choose a strong, unique one)
ADMIN_PASSWORD=

# Salt used to hash visitor IPs (generate once:  openssl rand -hex 16)
# Optional but recommended — if empty, a fallback salt is used.
TRACKING_SALT=
